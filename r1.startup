#!/bin/bash

sysctl -w net.ipv4.ip_forward=1

ip addr add 10.0.0.14/30 dev eth0
ip link set eth0 up

ip addr add 10.0.0.1/30 dev eth1
ip link set eth1 up

ip addr add 192.168.1.1/24 dev eth2
ip link set eth2 up

ip route add 192.168.2.0/24 via 10.0.0.2 dev eth1

ip route add 10.0.0.4/30 via 10.0.0.2 dev eth1

ip route add 10.0.0.8/30 via 10.0.0.2 dev eth1


