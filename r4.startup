#!/bin/bash

sysctl -w net.ipv4.ip_forward=1

ip addr add 10.0.0.10/30 dev eth0
ip link set eth0 up

ip addr add 10.0.0.13/30 dev eth1
ip link set eth1 up

ip route add 192.168.1.0/24 via 10.0.0.14 dev eth1

ip route add 192.168.2.0/24 via 10.0.0.9 dev eth0

ip route add 10.0.0.0/30 via 10.0.0.14 dev eth1

ip route add 10.0.0.4/30 via 10.0.0.9 dev eth0

